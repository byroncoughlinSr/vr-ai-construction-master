# VR AI Construction Project - Backend Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration
DATABASE_URL=postgresql://vr_admin:SecurePassword123!@postgres:5432/vr_construction

# AI Services
# IMPORTANT: Ollama should be installed natively on the host (not in Docker)
# For backend running in Docker, use the Docker bridge IP: http://172.17.0.1:11434
# For backend running natively, use: http://localhost:11434
OLLAMA_URL=http://172.17.0.1:11434

# Optional but RECOMMENDED: Add your Gemini API key for fallback when Ollama fails
# Get your FREE key from: https://makersuite.google.com/app/apikey
# This provides automatic fallback if Ollama has memory issues
GEMINI_API_KEY=

# Environment
ENVIRONMENT=development

# File Storage Paths (relative to app root)
UPLOADS_DIR=uploads
GENERATED_IMAGES_DIR=generated_images
EXPORTS_DIR=exports
